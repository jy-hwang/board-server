<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fastcampus.boardserver.mapper.TagMapper">

    <insert id="register" parameterType="com.fastcampus.boardserver.dto.TagDTO">
        INSERT
          INTO tag (name, url)
        VALUES (#{name}, #{url})
        <selectKey keyProperty="no" resultType="Integer" order="AFTER">
        SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <update id="update" parameterType="com.fastcampus.boardserver.dto.TagDTO">
        UPDATE tag
           SET name = #{name}
             , url = #{url}
         WHERE no = #{no}
    </update>

    <delete id="delete">
        DELETE
          FROM tag
         WHERE no = #{no}
    </delete>

    <insert id="createPostTag">
        INSERT
          INTO post_tag (tag_no, post_no)
        VALUES (#{tagNo}, #{postNo})
    </insert>

</mapper>